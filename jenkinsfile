pipeline {
  agent any
  environment {
    IMAGE       = "akshit0o/animal-adoption"
    TAG         = "${env.BUILD_NUMBER}"
    CREDS       = "dockerhub-creds"
    DEPLOYMENT  = "animal-adoption"
    CONTAINER   = "animal-adoption"
  }

  stages {
    stage('Checkout SCM') {
      steps { checkout scm }
    }

    stage('Build Docker Image') {
      steps {
        sh "docker build -f dockerfile -t ${IMAGE}:${TAG} ."
      }
    }

    stage('Push to Docker Hub') {
      steps {
        withCredentials([usernamePassword(credentialsId: env.CREDS, usernameVariable: 'USER', passwordVariable: 'PASS')]) {
          sh 'echo $PASS | docker login -u $USER --password-stdin'
          sh "docker push ${IMAGE}:${TAG}"
        }
      }
    }

    stage('Deploy to Kubernetes') {
      steps {
        sh "kubectl apply -f k8s/service.yaml || true"
        sh "kubectl apply -f k8s/deployment.yaml || true"
        sh "kubectl set image deployment/${DEPLOYMENT} ${CONTAINER}=${IMAGE}:${TAG} --record"
        sh "kubectl rollout status deployment/${DEPLOYMENT} -w --timeout=180s"
      }
    }
  }

  post {
    always { echo "Pipeline build ${currentBuild.currentResult}" }
  }
}
